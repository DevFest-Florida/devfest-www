---
import GoogleLogo from '~/assets/images/sponsors/Google_2015_logo.png';
import DataKindLogo from '~/assets/images/sponsors/DK_LOGO_R_ORG-2.png';
import DataPsyLogo from '~/assets/images/sponsors/data-psy-transparent.png';
import DataPsyLogoWhite from '~/assets/images/sponsors/data-psy-white.png';
import LatoAiLogo from '~/assets/images/sponsors/lato-ai.png';
import LatoAiLogoWhite from '~/assets/images/sponsors/lato-ai-white.png';
import VonageLogo from '~/assets/images/sponsors/vonage-transparent.png';
import VonageLogoWhite from '~/assets/images/sponsors/vonage-white.png';
import TekSystemsLogo from '~/assets/images/sponsors/teksystems.png';
import BotLogoBlack from '~/assets/images/sponsors/BOT_10YRGala_logo_Black (2).png';
import BotLogoWhite from '~/assets/images/sponsors/BOT_10YRGala_logo_white (1).png';
import JetBrainsLogo from '~/assets/images/sponsors/jetbrains.png';
import JetBrainsLogoWhite from '~/assets/images/sponsors/jetbrains-mono-white.png';
import KodecoLogo from '~/assets/images/sponsors/kodeco-orange.png';
import KodecoLogoWhite from '~/assets/images/sponsors/kodeco-white.png';
import OneSparkLogo from '~/assets/images/sponsors/onespark.png';
import OneSparkLogoWhite from '~/assets/images/sponsors/onespark-white.png';
---

<h3 class="text-center my-10 font-bold text-2xl md:text-3xl">Partner</h3>
<section class="w-11/12 md:w-10/12 max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-10 md:gap-14 items-center justify-items-center">
  <a href="https://developers.google.com/" target="_blank" rel="noopener noreferrer" class="w-full min-w-0 flex justify-center items-center">
    <img src={GoogleLogo.src} alt="Google Logo" class="object-contain h-24 md:h-32 w-full max-w-[300px] md:max-w-sm px-4 mx-auto" />
  </a>
  <a href="https://www.datakind.org/" target="_blank" rel="noopener noreferrer" class="w-full min-w-0 flex justify-center items-center">
    <img
      src={DataKindLogo.src}
      alt="DataKind Logo"
      class="object-contain h-20 md:h-26 w-full max-w-[300px] md:max-w-sm px-4 mx-auto"
    />
  </a>
  <a href="https://www.datapsy.com/" target="_blank" rel="noopener noreferrer" class="w-full min-w-0 flex justify-center items-center">
    <img
      src={DataPsyLogo.src}
      alt="DataPsy Logo"
      class="object-contain h-24 md:h-30 w-full max-w-[320px] md:max-w-sm px-4 mx-auto block dark:hidden"
    />
    <img
      src={DataPsyLogoWhite.src}
      alt="DataPsy Logo"
      class="object-contain h-24 md:h-30 w-full max-w-[320px] md:max-w-sm px-4 mx-auto hidden dark:block"
    />
  </a>
  <a href="https://latoai.com/" target="_blank" rel="noopener noreferrer" class="w-full min-w-0 flex justify-center items-center">
    <img
      src={LatoAiLogo.src}
      alt="Lato AI Logo"
      class="object-contain h-22 md:h-28 w-full max-w-[320px] md:max-w-sm px-4 mx-auto block dark:hidden"
    />
    <img
      src={LatoAiLogoWhite.src}
      alt="Lato AI Logo"
      class="object-contain h-22 md:h-28 w-full max-w-[320px] md:max-w-sm px-4 mx-auto hidden dark:block"
    />
  </a>
</section>

<h3 class="text-center my-10 font-semibold">Diamond</h3>
<section class="w-11/12 md:w-10/12 max-w-4xl mx-auto flex justify-center items-center">
  <a href="https://www.vonage.com/" target="_blank" rel="noopener noreferrer" class="w-full md:w-3/4 lg:w-2/3 min-w-0 flex justify-center items-center">
    <img
      src={VonageLogo.src}
      alt="Vonage Logo"
      class="object-contain h-24 md:h-28 w-full max-w-[280px] md:max-w-xs px-2 mx-auto block dark:hidden"
    />
    <img
      src={VonageLogoWhite.src}
      alt="Vonage Logo"
      class="object-contain h-24 md:h-28 w-full max-w-[280px] md:max-w-xs px-2 mx-auto hidden dark:block"
    />
  </a>
</section>

<h3 class="text-center my-10 font-semibold">Copper</h3>
<section class="w-11/12 md:w-10/12 max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 items-center justify-items-center">
  <a href="https://www.teksystems.com/" target="_blank" rel="noopener noreferrer" class="w-full min-w-0 flex justify-center items-center">
    <img
      src={TekSystemsLogo.src}
      alt="TEKsystems Logo"
      class="object-contain h-20 md:h-24 w-full max-w-[280px] md:max-w-xs px-2 mx-auto dark:brightness-0 dark:invert"
    />
  </a>
  <a href="https://blackorlandotech.org/" target="_blank" rel="noopener noreferrer" class="w-full min-w-0 flex justify-center items-center">
    <img
      src={BotLogoBlack.src}
      alt="Black Orlando Tech Logo"
      class="object-contain h-24 md:h-28 w-full max-w-[280px] md:max-w-xs px-2 mx-auto block dark:hidden"
    />
    <img
      src={BotLogoWhite.src}
      alt="Black Orlando Tech Logo"
      class="object-contain h-24 md:h-28 w-full max-w-[280px] md:max-w-xs px-2 mx-auto hidden dark:block"
    />
  </a>
</section>

<h3 class="text-center my-10 font-semibold">Community Supporter</h3>
<section class="w-full md:w-11/12 max-w-5xl px-4 mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10 lg:gap-12 items-center justify-items-center">
  <a href="https://www.jetbrains.com/" target="_blank" rel="noopener noreferrer" class="w-full min-w-0 flex justify-center items-center px-2">
    <img
      src={JetBrainsLogo.src}
      alt="JetBrains Logo"
      class="object-contain h-12 sm:h-14 xl:h-16 w-full max-w-[200px] sm:max-w-[220px] xl:max-w-[240px] mx-auto block dark:hidden"
    />
    <img
      src={JetBrainsLogoWhite.src}
      alt="JetBrains Logo"
      class="object-contain h-12 sm:h-14 xl:h-16 w-full max-w-[200px] sm:max-w-[220px] xl:max-w-[240px] mx-auto hidden dark:block"
    />
  </a>
  <a href="https://www.kodeco.com/" target="_blank" rel="noopener noreferrer" class="w-full min-w-0 flex justify-center items-center px-2">
    <img
      src={KodecoLogo.src}
      alt="Kodeco Logo"
      class="object-contain h-11 sm:h-12 xl:h-14 w-full max-w-[190px] sm:max-w-[210px] xl:max-w-[230px] mx-auto block dark:hidden"
    />
    <img
      src={KodecoLogoWhite.src}
      alt="Kodeco Logo"
      class="object-contain h-11 sm:h-12 xl:h-14 w-full max-w-[190px] sm:max-w-[210px] xl:max-w-[230px] mx-auto hidden dark:block"
    />
  </a>
  <a href="https://onespark.dev/" target="_blank" rel="noopener noreferrer" class="w-full min-w-0 sm:col-span-2 lg:col-span-1 flex justify-center items-center px-2">
    <img
      src={OneSparkLogo.src}
      alt="OneSpark Logo"
      class="object-contain h-12 sm:h-14 xl:h-16 w-full max-w-[200px] sm:max-w-[220px] xl:max-w-[240px] mx-auto block dark:hidden"
    />
    <img
      src={OneSparkLogoWhite.src}
      alt="OneSpark Logo"
      class="object-contain h-12 sm:h-14 xl:h-16 w-full max-w-[200px] sm:max-w-[220px] xl:max-w-[240px] mx-auto hidden dark:block"
    />
  </a>
</section>
