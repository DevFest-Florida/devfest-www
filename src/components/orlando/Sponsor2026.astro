---
import GoogleLogo from '../../assets/images/sponsors/Google_2015_logo.png';
import JetBrainsLogo from '../../assets/images/sponsors/jetbrains.png';
import JetBrainsLogoWhite from '../../assets/images/sponsors/jetbrains-mono-white.png';
import TekSystemsLogo from '../../assets/images/sponsors/teksystems.png';
import VonageLogo from '~/assets/images/sponsors/Vonage_Logo.png';
---

<h3 class="text-center my-10 font-semibold">Partner</h3>
<section class="w-10/12 mx-auto flex justify-center">
  <a href="https://developers.google.com/" target="_blank" class="w-full md:w-3/4 lg:w-2/3 flex justify-center">
    <img src={GoogleLogo.src} alt="Google Logo" class="object-contain h-28 md:h-32 w-full px-2 mx-auto" />
  </a>
</section>

<h3 class="text-center my-10 font-semibold">Diamond</h3>
<section class="w-10/12 mx-auto flex justify-center">
  <a href="https://www.vonage.com/" target="_blank" class="w-full md:w-3/4 lg:w-2/3 flex justify-center">
    <img src={VonageLogo.src} alt="Vonage Logo" class="object-contain h-28 md:h-32 w-full px-2 mx-auto" />
  </a>
</section>

<h3 class="text-center my-10 font-semibold">Copper</h3>
<section class="w-10/12 mx-auto flex justify-center">
  <a href="https://www.teksystems.com/" target="_blank" class="w-full md:w-2/3 lg:w-1/2 flex justify-center">
    <img
      src={TekSystemsLogo.src}
      alt="TEKsystems Logo"
      class="object-contain h-20 md:h-24 w-full px-2 mx-auto dark:brightness-0 dark:invert"
    />
  </a>
</section>

<h3 class="text-center my-10 font-semibold">Community Supporter</h3>
<section class="w-10/12 mx-auto flex justify-center">
  <a href="https://www.jetbrains.com/" target="_blank" class="w-full md:w-1/2 lg:w-2/5 flex justify-center">
    <img
      src={JetBrainsLogo.src}
      alt="JetBrains Logo"
      class="object-contain h-16 md:h-20 w-full px-2 mx-auto block dark:hidden"
    />
    <img
      src={JetBrainsLogoWhite.src}
      alt="JetBrains Logo"
      class="object-contain h-16 md:h-20 w-full px-2 mx-auto hidden dark:block"
    />
  </a>
</section>
