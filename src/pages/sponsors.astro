---
import Sponsor2 from '~/components/orlando/Sponsor2.astro';
import Button from '~/components/ui/Button.astro';
import Layout from '~/layouts/PageLayout.astro';
---

<Layout>
  <h1 class="text-center">Thank You to Our 2025 Sponsors</h1>

  <p class="mx-auto w-10/12 py-4 text-center text-lg text-slate-700 dark:text-gray-300">
    Grateful to the partners who powered DevFest GemJam 2025. The sponsor deck and prospectus below
    are for <strong>DevFest Hackathon 2026</strong> &mdash; reach out to bring your brand to the 2026
    hackathon.
  </p>

  <Sponsor2 />

  <hr class="py-10" />

  <section class="w-10/12 mx-auto">
    <div>
      <h2 class="text-center my-10">Why Sponsor DevFest Florida?</h2>
      <ul>
        <li class="my-10 text-lg">
          <span class="font-semibold">Technical Recruiting:</span> DevFest Florida is a great opportunity to meet emerging
          talent in the Florida tech industry.
        </li>
        <li class="my-10 text-lg">
          <span class="font-semibold">Brand Recognition/Product Exposure:</span> Expand your brand presence and expose attendees,
          partners, and press to your company, product, or API.
        </li>
        <li class="my-10 text-lg">
          <span class="font-semibold">Support the Florida Tech Community:</span> We are excited to be a part of the growing
          tech community in Florida. Join us!
        </li>
      </ul>
      <Button
        text="Become a Sponsor"
        variant="primary"
        target="_blank"
        icon="tabler:mail"
        href="mailto:organizers@devfestflorida.com"
      />
      <Button
        text="View Sponsor Prospectus"
        variant="primary"
        target="_blank"
        icon="tabler:file-text"
        href="https://docs.google.com/document/d/1Yue810Jx6DcgMccoUhSpa2Fga-VqY7ev-RDsmmHrWcA/view"
      />
    </div>
  </section>

  <section class="w-10/12 py-10 mx-auto flex justify-center">
    <iframe
      src="https://docs.google.com/presentation/d/e/2PACX-1vR_fg4-cSmwPl610fpbU41a1JN8iGfTrTZhFuHPKQuzbKBVIXXCWAU_CPpAsyY1Q3wRVg6vlvf2_xUv/pubembed?start=true&loop=true&delayms=5000"
      frameborder="0"
      width="960"
      height="569"
      allowfullscreen="true"
      mozallowfullscreen="true"
      webkitallowfullscreen="true"></iframe>
  </section>
</Layout>
