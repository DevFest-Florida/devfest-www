---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout>
  <section class="theme-section">
    <!-- Hero -->
    <div class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:px-8 md:py-28 lg:px-12">
        <div class="mx-auto max-w-3xl text-center">
          <span
            class="theme-accent-blue inline-flex items-center gap-2 rounded-full border border-[#4285f4]/40 bg-[#4285f4]/10 px-4 py-1 text-xs font-semibold uppercase tracking-[0.2em]"
          >
            <span class="h-2 w-2 rounded-full bg-[#4285f4]"></span>
            Programming in planning
          </span>
          <h1 class="theme-heading mt-6 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl md:text-6xl">
            Schedule — Coming Soon
          </h1>
          <p class="theme-copy mt-6 text-lg sm:text-xl">
            DevFest Hackathon 2026 is a three-day collaboration and creative sprint, November 6&ndash;8 in Orlando, FL.
            The full programming keynotes, workshops, hackathon tracks, and closing showcase is being finalized and will
            be announced here first.
          </p>
          <p class="theme-copy mt-3 text-base">
            Want to be notified when sessions are announced? Email
            <a
              href="mailto:organizers@devfestflorida.com?subject=DevFest%20Hackathon%202026%20Schedule%20Updates"
              class="theme-accent-blue font-semibold underline decoration-current/60 underline-offset-4 hover:opacity-80"
              >organizers@devfestflorida.com</a
            >.
          </p>
        </div>
      </div>
    </div>

    <!-- 3-day agenda cards -->
    <div class="container mx-auto px-4 pb-20 md:px-8 md:pb-28 lg:px-12">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="theme-heading text-3xl font-bold sm:text-4xl">A Glimpse at the Three Days</h2>
        <p class="theme-copy mt-4 text-base">
          A high-level look at the shape of the 2026 program. Specific sessions, speakers, and workshops will roll out
          over the coming weeks.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <div class="theme-card rounded-3xl border-4 border-solid border-[#4285f4] p-8">
          <span class="theme-accent-blue text-xs font-semibold uppercase tracking-[0.2em]">Day 1</span>
          <h3 class="theme-heading mt-3 text-2xl font-bold">November 6 &mdash; Opening Day</h3>
          <p class="theme-copy mt-3">Kickoff, registration, and community building. Programming details coming soon.</p>
        </div>

        <div class="theme-card rounded-3xl border-4 border-solid border-[#ea4335] p-8">
          <span class="theme-accent-red text-xs font-semibold uppercase tracking-[0.2em]">Day 2</span>
          <h3 class="theme-heading mt-3 text-2xl font-bold">November 7 &mdash; DevFest Programming</h3>
          <p class="theme-copy mt-3">
            A full day of sessions, workshops, and hands-on collaboration. Programming details coming soon.
          </p>
        </div>

        <div class="theme-card rounded-3xl border-4 border-solid border-[#34a853] p-8">
          <span class="theme-accent-green text-xs font-semibold uppercase tracking-[0.2em]">Day 3</span>
          <h3 class="theme-heading mt-3 text-2xl font-bold">November 8 &mdash; Closing Day</h3>
          <p class="theme-copy mt-3">
            Project showcases, celebration, and community networking. Programming details coming soon.
          </p>
        </div>
      </div>

      <!-- "What we'll be announcing" callout -->
      <div
        class="theme-card theme-copy mx-auto mt-16 max-w-3xl rounded-2xl border-l-4 border-[#f9ab00] px-6 py-5 text-left shadow-lg"
      >
        <p class="theme-heading text-lg font-bold sm:text-xl">What we&rsquo;ll be announcing</p>
        <ul class="mt-3 list-disc space-y-1 pl-6 text-sm sm:text-base">
          <li>Opening keynote and featured speaker lineup</li>
          <li>Workshop schedule and hands-on lab sign-ups</li>
          <li>Hackathon tracks, judging criteria, and submission timelines</li>
          <li>Closing showcase format and community networking events</li>
        </ul>
      </div>

      <!-- Archive link -->
      <div class="mt-12 text-center">
        <p class="theme-copy text-sm">
          Curious what the 2025 day-of program looked like?
          <a
            href="/2025/schedule"
            class="theme-accent-blue font-semibold underline decoration-current/60 underline-offset-4 hover:opacity-80"
            >Browse the 2025 schedule archive</a
          >.
        </p>
      </div>
    </div>
  </section>
</Layout>
