---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout>
  <section class="bg-[#1e1e1e]">
    <!-- Hero -->
    <div class="relative overflow-hidden">
      <div class="container mx-auto px-4 py-20 md:px-8 md:py-28 lg:px-12">
        <div class="mx-auto max-w-3xl text-center">
          <span
            class="inline-flex items-center gap-2 rounded-full border border-[#4285f4]/40 bg-[#4285f4]/10 px-4 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-[#f0f0f0]"
          >
            <span class="h-2 w-2 rounded-full bg-[#4285f4]"></span>
            Programming in planning
          </span>
          <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl md:text-6xl">
            Schedule — Coming Soon
          </h1>
          <p class="mt-6 text-lg text-[#f0f0f0]/80 sm:text-xl">
            DevFest Hackathon 2026 is a three-day collaboration and creative sprint, November 6&ndash;8 in Orlando, FL.
            The full programming keynotes, workshops, hackathon tracks, and closing showcase is being
            finalized and will be announced here first.
          </p>
          <p class="mt-3 text-base text-[#f0f0f0]/70">
            Want to be notified when sessions are announced? Email
            <a
              href="mailto:organizers@devfestflorida.com?subject=DevFest%20Hackathon%202026%20Schedule%20Updates"
              class="font-semibold text-[#4285f4] underline decoration-[#4285f4]/60 underline-offset-4 hover:text-[#f0f0f0]"
              >organizers@devfestflorida.com</a
            >.
          </p>
        </div>
      </div>
    </div>

    <!-- 3-day agenda cards -->
    <div class="container mx-auto px-4 pb-20 md:px-8 md:pb-28 lg:px-12">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="text-3xl font-bold text-white sm:text-4xl">A Glimpse at the Three Days</h2>
        <p class="mt-4 text-base text-[#f0f0f0]/70">
          A high-level look at the shape of the 2026 program. Specific sessions, speakers, and workshops will roll out
          over the coming weeks.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <div class="rounded-3xl border-4 border-solid border-[#4285f4] bg-[#1e1e1e] p-8">
          <span class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4285f4]">Day 1</span>
          <h3 class="mt-3 text-2xl font-bold text-white">November 6 &mdash; Opening Day</h3>
          <p class="mt-3 text-[#f0f0f0]/80">
            Kickoff, registration, and community building. Programming details coming soon.
          </p>
        </div>

        <div class="rounded-3xl border-4 border-solid border-[#ea4335] bg-[#1e1e1e] p-8">
          <span class="text-xs font-semibold uppercase tracking-[0.2em] text-[#ea4335]">Day 2</span>
          <h3 class="mt-3 text-2xl font-bold text-white">November 7 &mdash; DevFest Programming</h3>
          <p class="mt-3 text-[#f0f0f0]/80">
            A full day of sessions, workshops, and hands-on collaboration. Programming details coming soon.
          </p>
        </div>

        <div class="rounded-3xl border-4 border-solid border-[#34a853] bg-[#1e1e1e] p-8">
          <span class="text-xs font-semibold uppercase tracking-[0.2em] text-[#34a853]">Day 3</span>
          <h3 class="mt-3 text-2xl font-bold text-white">November 8 &mdash; Closing Day</h3>
          <p class="mt-3 text-[#f0f0f0]/80">
            Project showcases, celebration, and community networking. Programming details coming soon.
          </p>
        </div>
      </div>

      <!-- "What we'll be announcing" callout -->
      <div
        class="mx-auto mt-16 max-w-3xl rounded-2xl border-l-4 border-[#f9ab00] bg-[#f0f0f0]/95 px-6 py-5 text-left text-[#1e1e1e] shadow-lg"
      >
        <p class="text-lg font-bold sm:text-xl">What we&rsquo;ll be announcing</p>
        <ul class="mt-3 list-disc space-y-1 pl-6 text-sm sm:text-base">
          <li>Opening keynote and featured speaker lineup</li>
          <li>Workshop schedule and hands-on lab sign-ups</li>
          <li>Hackathon tracks, judging criteria, and submission timelines</li>
          <li>Closing showcase format and community networking events</li>
        </ul>
      </div>

      <!-- Archive link -->
      <div class="mt-12 text-center">
        <p class="text-sm text-[#f0f0f0]/70">
          Curious what the 2025 day-of program looked like?
          <a
            href="/2025/schedule"
            class="font-semibold text-[#4285f4] underline decoration-[#4285f4]/60 underline-offset-4 hover:text-[#f0f0f0]"
            >Browse the 2025 schedule archive</a
          >.
        </p>
      </div>
    </div>
  </section>
</Layout>
