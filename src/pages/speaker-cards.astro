---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import { speakers } from '~/data/speakers2026';

const metadata = {
  title: 'Speaker Cards | DevFest Florida 2026',
  robots: { index: false, follow: false },
};

// DevFest palette: yellow, blue, pink, green, orange, red
const palettes = [
  { bg: '#ffe8a8', accent: '#4285f4' },
  { bg: '#d0f5d8', accent: '#ff7eb6' },
  { bg: '#fad9dc', accent: '#34a853' },
  { bg: '#cfe9fb', accent: '#fbab00' },
  { bg: '#ffe8a8', accent: '#ea4335' },
];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <h1 class="mb-2 text-3xl font-bold">Speaker Cards</h1>
    <p class="mb-8 text-muted">Shareable cards for every DevFest Florida 2026 speaker. Screenshot a card to use it.</p>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        speakers.map((speaker, i) => {
          const p = palettes[i % palettes.length];
          return (
            <div class="flex flex-col items-center gap-3">
              <article
                id={speaker.id}
                class="speaker-card relative flex h-[38rem] w-full flex-col overflow-hidden rounded-3xl border-2 border-black px-6 py-4 text-black"
                style={`background:${p.bg}`}
              >
                <span class="shape-a" style={`background:${p.accent}`} aria-hidden="true" />
                <span class="shape-b" aria-hidden="true" />

                <img
                  src="/logo512.png"
                  alt="DevFest Florida logo"
                  width="80"
                  height="80"
                  class="relative z-10 mx-auto mb-2 h-20 w-20"
                />

                {speaker.image && (
                  <Image
                    src={speaker.image}
                    width={400}
                    height={400}
                    alt={speaker.imageAlt ?? speaker.name}
                    format="webp"
                    quality={80}
                    class="relative z-10 mx-auto mb-3 aspect-square w-44 rounded-full border-2 border-black object-cover"
                    style={`box-shadow:6px 6px 0 ${p.accent}`}
                  />
                )}

                <h2 class="relative z-10 text-center text-2xl font-extrabold">{speaker.name}</h2>
                <p class="relative z-10 mb-3 text-center text-sm font-medium">
                  {speaker.role} · {speaker.company}
                </p>

                <div class="relative z-10 mt-auto rounded-2xl border-2 border-black bg-white px-4 py-2">
                  <p class="font-bold leading-snug">{speaker.talkTitle}</p>
                </div>

                <p class="relative z-10 mt-2 text-center text-sm font-bold">Learn more at DevFestFlorida.com</p>
              </article>
              <button
                type="button"
                class="download-btn rounded-full border-2 border-black bg-white px-5 py-2 text-sm font-bold text-black hover:bg-gray-100"
                data-target={speaker.id}
              >
                Download card
              </button>
            </div>
          );
        })
      }
    </div>
  </section>
</Layout>

<script>
  import { toBlob } from 'html-to-image';

  document.querySelectorAll<HTMLButtonElement>('.download-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const card = document.getElementById(btn.dataset.target!);
      if (!card) return;
      const label = btn.textContent;
      try {
        const blob = await toBlob(card, { pixelRatio: 2, cacheBust: true, includeQueryParams: true });
        if (!blob) throw new Error('render failed');
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `${btn.dataset.target}.png`;
        a.click();
        URL.revokeObjectURL(a.href);
        btn.textContent = 'Downloaded!';
      } catch {
        btn.textContent = 'Failed';
      }
      setTimeout(() => (btn.textContent = label), 2000);
    });
  });
</script>

<style>
  .speaker-card {
    box-shadow: 6px 6px 0 #000;
  }
  .shape-a {
    position: absolute;
    top: -2rem;
    right: -2rem;
    width: 7rem;
    height: 7rem;
    border: 2px solid #000;
    border-radius: 9999px;
  }
  .shape-b {
    position: absolute;
    bottom: 40%;
    left: -1.5rem;
    width: 3.5rem;
    height: 3.5rem;
    background: #fff;
    border: 2px solid #000;
    transform: rotate(45deg);
    opacity: 0.6;
  }
</style>
