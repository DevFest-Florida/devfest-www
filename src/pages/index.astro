---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';

import About from '~/components/orlando/About.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Contact from '~/components/widgets/Contact.astro';
import CustomStyles from '~/components/orlando/CustomStyles.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Footer from '~/components/orlando/Footer.astro';
import Hero from '~/components/widgets/Hero2.astro';
import LatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Note from '~/components/widgets/Note.astro';
import SpeakerProfiles from '~/components/orlando/SpeakerProfiles2025.astro';
import Speakers from '~/components/orlando/SpeakerProfiles.astro';
import Sponsor from '~/components/orlando/Sponsor2.astro';
import Sponsors from '~/components/orlando/Sponsor.astro';
import Steps from '~/components/widgets/Steps.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Venue from '~/components/orlando/Venue.astro';
import DevFestFans from '~/assets/images/devfest-fans.jpg';
import DevFestSaveTheDate2026 from '~/assets/images/2026/devFestFloridaSaveTheDate2026.png';
import GdgCentralFloridaLogo from '~/assets/images/2026/GDG ProfessionalHorizontalLight.png';

const posts = await getCollection('post');

const metadata = {
  title: 'DevFest Hackathon 2026 | November 6–8',
  description:
    'Save the date for DevFest Hackathon 2026, November 6–8. Venue and registration details are coming soon.',
};
---

<style>
  .sectionHero {
    background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 2)), url('~/assets/images/devfest-hero.jpg');
  }
</style>
<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section id="home" class="relative sectionHero min-h-screen flex items-center justify-center text-center p-4 pt-24">
    <div class="relative z-10 max-w-4xl mx-auto">
      <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-white leading-tight mb-4">
        DevFest Hackathon 2026
      </h2>
      <p class="text-xl sm:text-2xl md:text-3xl font-light mb-8 text-white">Build, Innovate & Connect</p>
      <p class="text-xl sm:text-2xl md:text-3xl font-light mb-8 text-white">November 6–8, 2026</p>
      <p class="text-white">
        DevFest Hackathon 2026 is a welcoming space where people of all backgrounds come together to imagine, build, and share
        ideas for a better future. Instead of focusing on competition or speed, we emphasize collaboration, creativity,
        and community impact. With AI transforming the world, we approach it as a tool for augmentation, not replacement
        — a partner that supports human creativity, connection, and problem-solving.
      </p>
      <p class="text-white">
        At this event, participants explore how to use AI responsibly and ethically, ensuring that innovation is guided
        by inclusivity, fairness, and care for people. Whether you’re a coder, designer, storyteller, or community
        builder, there’s a place for your voice. Together, we’ll create solutions that reflect both human ingenuity and
        human values.
      </p>

      <!-- Countdown Timer -->
      <div
        id="countdown"
        class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-12 text-white"
        role="group"
        aria-labelledby="countdown-heading"
      >
        <p id="countdown-heading" class="sr-only">Time remaining until DevFest Hackathon 2026 begins</p>
        <div data-countdown-card class="rounded-xl border-t-4 border-[#4285f4] bg-[#1e1e1e] p-4 shadow-lg" aria-hidden="true">
          <time id="days" class="text-4xl font-bold text-[#4285f4] sm:text-5xl">00</time>
          <div class="mt-2 text-sm font-light uppercase tracking-widest text-gray-300">Days</div>
        </div>
        <div data-countdown-card class="rounded-xl border-t-4 border-[#ea4335] bg-[#1e1e1e] p-4 shadow-lg" aria-hidden="true">
          <time id="hours" class="text-4xl font-bold text-[#ea4335] sm:text-5xl">00</time>
          <div class="mt-2 text-sm font-light uppercase tracking-widest text-gray-300">Hours</div>
        </div>
        <div data-countdown-card class="rounded-xl border-t-4 border-[#f9ab00] bg-[#1e1e1e] p-4 shadow-lg" aria-hidden="true">
          <time id="minutes" class="text-4xl font-bold text-[#f9ab00] sm:text-5xl">00</time>
          <div class="mt-2 text-sm font-light uppercase tracking-widest text-gray-300">Minutes</div>
        </div>
        <div data-countdown-card class="rounded-xl border-t-4 border-[#34a853] bg-[#1e1e1e] p-4 shadow-lg" aria-hidden="true">
          <time id="seconds" class="text-4xl font-bold text-[#34a853] sm:text-5xl">00</time>
          <div class="mt-2 text-sm font-light uppercase tracking-widest text-gray-300">Seconds</div>
        </div>
        <p id="countdown-complete" class="col-span-2 hidden text-center text-2xl font-bold text-[#f0f0f0] sm:col-span-4 sm:text-3xl">
          The event has kicked off!!
        </p>
      </div>
      <p id="countdown-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
      <aside
        class="mb-8 rounded-2xl border-l-4 border-[#4285f4] bg-[#f0f0f0]/95 px-5 py-4 text-left text-[#1e1e1e] shadow-lg sm:px-6"
        aria-label="DevFest Hackathon 2026 planning status"
      >
        <p class="text-lg font-bold sm:text-xl">Save the date — November 6–8, 2026</p>
        <p class="mt-1 text-sm sm:text-base">Venue and registration details are coming soon.</p>
      </aside>
      <!-- Main CTA Button -->
      <a
        href="mailto:organizers@devfestflorida.com?subject=DevFest%20Hackathon%202026%20Sponsorship"
        aria-label="Email the DevFest Florida organizers about sponsorship"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-[#4285f4] px-12 py-4 text-lg font-bold text-white shadow-lg transition-colors duration-300 hover:bg-[#3367d6] focus:outline-none focus-visible:ring-4 focus-visible:ring-[#c3ecf6] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1e1e1e]"
      >
        <Icon name="tabler:mail" class="h-5 w-5" aria-hidden="true" />
        Become a Sponsor
      </a>
    </div>
  </section>

  <section class="container mx-auto px-4 py-12 md:px-8 lg:px-12" aria-labelledby="save-the-date-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="save-the-date-heading" class="sr-only">Save the date for DevFest Hackathon 2026</h2>
      <img
        src={DevFestSaveTheDate2026.src}
        alt="Save the date for DevFest Florida Hackathon, November 6 through 8, 2026, in Orlando, Florida"
        width={DevFestSaveTheDate2026.width}
        height={DevFestSaveTheDate2026.height}
        loading="lazy"
        decoding="async"
        class="h-auto w-full rounded-3xl border border-slate-700 shadow-2xl"
      />
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="container mx-auto py-16 px-4 md:px-8 lg:px-12">
    <div class="text-center mb-12">
      <h3 class="text-3xl font-bold text-white mb-4">About the Event</h3>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        Join us for an electrifying, week-long sprint building GenAi powered apps—a flagship DevFest event designed to
        spark innovation and connect the brightest minds in tech. This is your unparalleled opportunity to dive deep
        into the thrilling realm of AI agents and discover how they seamlessly integrate with the cutting-edge power of
        Google's technologies.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div class="bg-amber-400 p-6 rounded-xl shadow-lg">
        <div class="text-4xl text-purple-400 mb-4">🤖</div>
        <h4 class="text-xl font-bold mb-2 text-black">Build with AI</h4>
        <p class="text-black">
          Craft groundbreaking solutions using Google's Gemini AI suite, Google Cloud Platform, and Firebase.
        </p>
      </div>
      <div class="bg-amber-400 p-6 rounded-xl shadow-lg">
        <div class="text-4xl text-purple-400 mb-4">🔗</div>
        <h4 class="text-xl font-bold mb-2 text-black">Forge Connections</h4>
        <p class="text-black">
          Network with brilliant developers, share insights, and form lasting friendships and collaborations.
        </p>
      </div>
      <div class="bg-amber-400 p-6 rounded-xl shadow-lg">
        <div class="text-4xl text-purple-400 mb-4">📈</div>
        <h4 class="text-xl font-bold mb-2 text-black">Elevate Your Profile</h4>
        <p class="text-black">
          Showcase your ingenuity and build impressive projects that will make your portfolio shine.
        </p>
      </div>
    </div>
  </section>

  <!-- Tracks Section -->
  <section id="tracks" class="container mx-auto py-16 px-4 md:px-8 lg:px-12">
    <div class="text-center mb-12">
      <h3 class="text-3xl font-bold text-white mb-4">Tracks</h3>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        Whether you're a builder or a visionary, we have a path for you.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-blue-800 p-8 rounded-xl shadow-lg border border-purple-600">
        <h4 class="text-2xl font-bold mb-2 text-white">
          <a href="app-mvp-rules">Software Prototype</a>
        </h4>
        <p class="text-gray-400">
          Develop a working MVP (Minimum Viable Product) of a high-impact software app or game enabled by AI. Bring your
          code to life and showcase your technical prowess.
        </p>
      </div>
      <div class="bg-blue-800 p-8 rounded-xl shadow-lg border border-purple-600">
        <h4 class="text-2xl font-bold mb-2 text-white">
          <a href="app-pitch">App Pitch</a>
        </h4>
        <p class="text-gray-400">
          Pitch a design and concept of operations for an app. Perfect for designers, project managers, and innovators
          who want to focus on strategy, user experience, and business potential.
        </p>
      </div>
      <div class="bg-blue-800 p-8 rounded-xl shadow-lg border border-purple-600">
        <h4 class="text-2xl font-bold mb-2 text-white">
          <a href="company-pitch">Singularity Startup Pitch</a>
        </h4>
        <p class="text-gray-400">
          Your team of Product Managers are tasked with creating a business plan + product definition for Event Horizon
          Labs. Imagine a strong business concept that leverages AI that surpasses human intelligence.
        </p>
      </div>
    </div>
  </section>

  <section id="community" class="container mx-auto py-16 px-4 md:px-8 lg:px-12">
    <div class="text-center mb-12">
      <h3 class="text-3xl font-bold text-white mb-4">Our Community</h3>
    </div>
    <img src={DevFestFans.src} alt="Meet our DevFest Fans" />
  </section>

  <!-- Schedule Section -->
  <section id="schedule" class="container mx-auto py-16 px-4 md:px-8 lg:px-12">
    <div class="text-center mb-12">
      <h3 class="text-3xl font-bold text-white mb-4">Agenda</h3>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        The DevFest Hackathon is a week-long collaboration and creative sprint, with an in-person kickoff and demo day.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-yellow-200 rounded-3xl border-solid border-4 border-black dark:text-black m-2 p-2 md:m-10 md:p-10">
        <h4 class="text-2xl font-bold mb-2 text-black">Oct 25: Kickoff</h4>
        <p class="text-black-400">
          The excitement begins! Registration, keynote, hands-on workshops and team formation.
        </p>
      </div>
      <div class="bg-yellow-200 rounded-3xl border-solid border-4 border-black dark:text-black m-2 p-2 md:m-10 md:p-10">
        <h4 class="text-2xl font-bold mb-2 text-black">Oct 26 - Oct 31: Build & Iterate</h4>
        <p class="text-black-400">Intense week of coding, collaboration, mentorship, and "show and tell" sessions.</p>
      </div>
      <div class="bg-yellow-200 rounded-3xl border-solid border-4 border-black dark:text-black m-2 p-2 md:m-10 md:p-10">
        <h4 class="text-2xl font-bold mb-2 text-black">Nov 2: Demo Day</h4>
        <p class="text-black-400">
          Final presentations, project celebration, and networking with the community at <a
            href="https://innovateorlando.io/tech-hub-orlando/">Tech Hub Orlando</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- Sponsors Section -->
  <section id="sponsors" class="container mx-auto py-16 px-4 md:px-8 lg:px-12">
    <div class="text-center mb-12">
      <h3 class="text-3xl font-bold text-white mb-4">Our 2025 Sponsors</h3>
    </div>
    <Sponsor />

    <br /><br /><br />
    <h2 class="w-10/12 mx-auto text-center mt-4">Venue</h2>
    <Venue />
  </section>

  <section class="border-t border-slate-700 bg-[#f0f0f0] px-4 py-10 text-center" aria-labelledby="organized-by-heading">
    <div class="mx-auto max-w-5xl">
      <h2 id="organized-by-heading" class="mb-5 text-sm font-semibold uppercase tracking-[0.2em] text-[#1e1e1e]">
        Organized by
      </h2>
      <img
        src={GdgCentralFloridaLogo.src}
        alt="Google Developer Group Central Florida"
        width={GdgCentralFloridaLogo.width}
        height={GdgCentralFloridaLogo.height}
        loading="lazy"
        decoding="async"
        class="mx-auto h-auto w-full max-w-3xl object-contain"
      />
    </div>
  </section>

  <!-- JavaScript for Countdown Timer and Mobile Menu -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const countdownDate = new Date('2026-11-06T09:00:00-05:00').getTime();
      const mobileMenuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');

      // Countdown Timer Logic
      const countdownCards = document.querySelectorAll('[data-countdown-card]');
      const countdownCompleteEl = document.getElementById('countdown-complete');
      const countdownStatusEl = document.getElementById('countdown-status');
      const daysEl = document.getElementById('days');
      const hoursEl = document.getElementById('hours');
      const minutesEl = document.getElementById('minutes');
      const secondsEl = document.getElementById('seconds');
      let countdownInterval: number | undefined;
      let lastAnnouncedMinute: number | undefined;

      const updateCountdown = () => {
        const distance = Math.max(0, countdownDate - Date.now());

        // Calculate time units
        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
        if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');

        if (distance === 0) {
          countdownCards.forEach((card) => card.classList.add('hidden'));
          countdownCompleteEl?.classList.remove('hidden');
          if (countdownStatusEl) countdownStatusEl.textContent = 'The event has kicked off!!';
          if (countdownInterval) window.clearInterval(countdownInterval);
          return false;
        }

        const totalMinutes = Math.floor(distance / (1000 * 60));
        if (totalMinutes !== lastAnnouncedMinute && countdownStatusEl) {
          countdownStatusEl.textContent = `${days} days, ${hours} hours, and ${minutes} minutes until DevFest Hackathon 2026 begins.`;
          lastAnnouncedMinute = totalMinutes;
        }

        return true;
      };

      if (updateCountdown()) {
        countdownInterval = window.setInterval(updateCountdown, 1000);
      }

      // Mobile Menu Toggle Logic
      if (mobileMenuButton && mobileMenu) {
        mobileMenuButton.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });

        // Close mobile menu when a link is clicked
        mobileMenu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
          });
        });
      }
    });
  </script>

  <style>
    /* Existing styles from devfest-hackathon.html */
    body {
      font-family: 'Inter', sans-serif;
      color: #e2e8f0; /* Light gray text for dark background */
    }
    /* A subtle animation for the hero background */
    @keyframes subtle-fade {
      0%,
      100% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
    }
    .hero-bg {
      background: linear-gradient(-45deg, #1a202c, #2d3748, #1a202c, #2d3748);
      background-size: 400% 400%;
      animation: subtle-fade 15s ease infinite;
    }
    .glow-button {
      transition: all 0.3s ease;
      box-shadow: 0 0 15px rgba(139, 92, 246, 0.4);
    }
    .glow-button:hover {
      box-shadow: 0 0 25px rgba(139, 92, 246, 0.6);
      transform: scale(1.05);
    }

    /* Additional styles from /src/assets/styles/tailwind.css if needed */
    /* Assuming Tailwind is configured in astro.config.mjs and applied via the Layout */
  </style>
</Layout>
