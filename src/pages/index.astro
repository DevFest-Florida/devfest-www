  <!-- JavaScript for Countdown Timer and Mobile Menu -->
  <script>
    const initCountdown = () => {
      const countdownDate = new Date('2026-11-06T09:00:00-05:00').getTime();
      const mobileMenuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');

      // Countdown Timer Logic
      const countdownCards = document.querySelectorAll('[data-countdown-card]');
      const countdownCompleteEl = document.getElementById('countdown-complete');
      const countdownStatusEl = document.getElementById('countdown-status');
      const daysEl = document.getElementById('days');
      const hoursEl = document.getElementById('hours');
      const minutesEl = document.getElementById('minutes');
      const secondsEl = document.getElementById('seconds');

      const w = window as unknown as { __dfCountdownInterval?: number };
      if (w.__dfCountdownInterval) {
        window.clearInterval(w.__dfCountdownInterval);
        w.__dfCountdownInterval = undefined;
      }

      const updateCountdown = () => {
        const distance = Math.max(0, countdownDate - Date.now());

        // Calculate time units
        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
        if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');

        if (distance === 0) {
          countdownCards.forEach((card) => card.classList.add('hidden'));
          countdownCompleteEl?.classList.remove('hidden');
          if (countdownStatusEl) countdownStatusEl.textContent = 'The event has kicked off!!';
          if (w.__dfCountdownInterval) {
            window.clearInterval(w.__dfCountdownInterval);
            w.__dfCountdownInterval = undefined;
          }
          return false;
        }

        if (countdownStatusEl) {
          countdownStatusEl.textContent = `${days} days, ${hours} hours, and ${minutes} minutes until DevFest Hackathon 2026 begins.`;
        }

        return true;
      };

      if (updateCountdown()) {
        w.__dfCountdownInterval = window.setInterval(updateCountdown, 1000);
      }

      // Mobile Menu Toggle Logic
      if (mobileMenuButton && mobileMenu) {
        mobileMenuButton.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });

        // Close mobile menu when a link is clicked
        mobileMenu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
          });
        });
      }
    };

    // Venue Slideshow Logic
    const initVenueCarousel = () => {
      const container = document.getElementById('venue-carousel');
      if (!container) return;

      const slides = container.querySelectorAll('[data-venue-slide]');
      const dots = container.querySelectorAll('[data-venue-dot]');
      const counter = document.getElementById('venue-slide-counter');
      const prevBtn = document.getElementById('venue-prev-btn');
      const nextBtn = document.getElementById('venue-next-btn');

      if (!slides.length) return;

      let currentIndex = 0;
      let autoplayTimer: number | undefined;

      const showSlide = (index: number) => {
        currentIndex = (index + slides.length) % slides.length;

        slides.forEach((slide, idx) => {
          if (idx === currentIndex) {
            slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
            slide.classList.add('opacity-100', 'z-10');
          } else {
            slide.classList.remove('opacity-100', 'z-10');
            slide.classList.add('opacity-0', 'pointer-events-none', 'z-0');
          }
        });

        dots.forEach((dot, idx) => {
          if (idx === currentIndex) {
            dot.className = 'h-2 sm:h-2.5 rounded-full transition-all duration-300 w-6 sm:w-8 bg-[#f9ab00]';
          } else {
            dot.className = 'h-2 sm:h-2.5 rounded-full transition-all duration-300 w-2 sm:w-2.5 bg-white/50 hover:bg-white';
          }
        });

        if (counter) {
          counter.textContent = `${currentIndex + 1} / ${slides.length}`;
        }
      };

      const nextSlide = () => showSlide(currentIndex + 1);
      const prevSlide = () => showSlide(currentIndex - 1);

      const startAutoplay = () => {
        stopAutoplay();
        autoplayTimer = window.setInterval(nextSlide, 5000);
      };

      const stopAutoplay = () => {
        if (autoplayTimer) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = undefined;
        }
      };

      // Button controls
      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        nextSlide();
        startAutoplay();
      });

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        prevSlide();
        startAutoplay();
      });

      // Dot controls
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          showSlide(idx);
          startAutoplay();
        });
      });

      // Pause on hover
      container.addEventListener('mouseenter', stopAutoplay);
      container.addEventListener('mouseleave', startAutoplay);

      // Keyboard controls
      container.addEventListener('keydown', (e) => {
        const keyboardEvent = e as KeyboardEvent;
        if (keyboardEvent.key === 'ArrowLeft') {
          prevSlide();
          startAutoplay();
        } else if (keyboardEvent.key === 'ArrowRight') {
          nextSlide();
          startAutoplay();
        }
      });

      // Touch swipe support for mobile
      let touchStartX = 0;
      container.addEventListener('touchstart', (e) => {
        const touchEvent = e as TouchEvent;
        touchStartX = touchEvent.changedTouches[0].screenX;
        stopAutoplay();
      }, { passive: true });

      container.addEventListener('touchend', (e) => {
        const touchEvent = e as TouchEvent;
        const touchEndX = touchEvent.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 50) {
          nextSlide();
        } else if (touchEndX - touchStartX > 50) {
          prevSlide();
        }
        startAutoplay();
      }, { passive: true });

      startAutoplay();
    };

    initCountdown();
    initVenueCarousel();

    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        initCountdown();
        initVenueCarousel();
      }
    });

    document.addEventListener('astro:page-load', () => {
      initCountdown();
      initVenueCarousel();
    });
  </script>

  <style>
    /* Existing styles from devfest-hackathon.html */
    body {
      font-family: 'Inter', sans-serif;
      color: #e2e8f0; /* Light gray text for dark background */
    }
    /* A subtle animation for the hero background */
    @keyframes subtle-fade {
      0%,
      100% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
    }
    .hero-bg {
      background: linear-gradient(-45deg, #1a202c, #2d3748, #1a202c, #2d3748);
      background-size: 400% 400%;
      animation: subtle-fade 15s ease infinite;
    }
    .glow-button {
      transition: all 0.3s ease;
      box-shadow: 0 0 15px rgba(139, 92, 246, 0.4);
    }
    .glow-button:hover {
      box-shadow: 0 0 25px rgba(139, 92, 246, 0.6);
      transform: scale(1.05);
    }

    /* Additional styles from /src/assets/styles/tailwind.css if needed */
    /* Assuming Tailwind is configured in astro.config.mjs and applied via the Layout */
  </style>
</Layout>
